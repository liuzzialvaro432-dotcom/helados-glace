{
  "name": "modellkatalog-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome extension for the five-category AI model catalog used by agencies",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite build --watch",
    "build": "npm run icons && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pdf": "python3 build_katalog.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^27.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
